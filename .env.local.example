# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (safe in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key: server only, bypasses row-level security
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Database password: only used by `bun run supabase:link`
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Stripe: test keys only (https://dashboard.stripe.com/test/apikeys)
# Secret key for the server
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# Signing secret for the /api/webhooks endpoint
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Resend: https://resend.com/api-keys
# API key used to send app emails
RESEND_API_KEY=re_your-resend-api-key
# Optional sender; defaults to "Fundwell <no-reply@fundwell.us>"
RESEND_FROM_EMAIL=

# Site
# Base URL for links and auth redirects; production is https://fundwell.us
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile on email sign-in (optional; leave blank to turn the check off)
# Public site key. The secret key goes in Supabase (Authentication > Bot and Abuse Protection), never here or in Vercel.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry (optional; leave blank to turn error tracking off)
# DSN for server and edge errors
SENTRY_DSN=
# DSN for browser errors
NEXT_PUBLIC_SENTRY_DSN=
# Set to true to send personal data with server and edge errors
SENTRY_SEND_PII=
# Set to true to send personal data with browser errors
NEXT_PUBLIC_SENTRY_SEND_PII=
# Build only: lets the Sentry plugin upload source maps
SENTRY_AUTH_TOKEN=

# Supabase edge functions (supabase/functions) don't read this file.
# Supabase provides these two to every function automatically; you can't set them:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Set these with `supabase secrets set`:
# Base URL for links in emails; defaults to https://fundwell.us
# SITE_URL=https://fundwell.us
# API key the functions use to send email
# RESEND_API_KEY=re_your-resend-api-key
# Optional sender; defaults to "Fundwell <no-reply@fundwell.us>"
# RESEND_FROM_EMAIL=Fundwell <no-reply@fundwell.us>
